---
import "../styles/global.css";
import { url } from "../lib/contenido";
export interface Props { titulo?: string; descripcion?: string; actual?: string }
const { titulo, descripcion, actual } = Astro.props;
const t = titulo ? `${titulo} · Entender Chile` : "Entender Chile · El resumen sin gritos";
const d = descripcion ?? "Las noticias de Chile, explicadas en diez minutos y sin gritos. Cada mañana, un informe con lo que de verdad importa, con las fuentes a la vista.";
const hoy = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t}</title>
    <meta name="description" content={d} />
    <meta property="og:title" content={t} />
    <meta property="og:description" content={d} />
    <meta property="og:type" content="article" />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="cab">
      <a class="marca" href={url("/")}>Entender Chile</a>
      <span class="tagline">El resumen sin gritos</span>
      <nav>
        <a href={url("informes/")} aria-current={actual === "informes" ? "page" : undefined}>Informes</a>
        <a href={url("claves/")} aria-current={actual === "claves" ? "page" : undefined}>Claves</a>
        <a href={url("acerca/")} aria-current={actual === "acerca" ? "page" : undefined}>Acerca</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <div class="in">
        <span>Entender Chile · El resumen sin gritos. Fuentes a la vista, hechos separados de las interpretaciones.</span>
        <span class="mono">Actualizado {hoy}</span>
      </div>
    </footer>
  </body>
</html>
