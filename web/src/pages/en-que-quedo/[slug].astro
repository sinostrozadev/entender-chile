---
import Base from "../../layouts/Base.astro";
import Indice from "../../components/Indice.astro";
import { casos, pesos, naturalezaTexto, fechaLarga, url } from "../../lib/contenido";
export function getStaticPaths() {
  return casos().map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const estadoTexto: Record<string, string> = { ACTIVO: "En investigación", JUDICIALIZADO: "En tribunales", CERRADO: "Cerrado" };
const pct = c.cuestionado ? ((c.recuperado || 0) / c.cuestionado) * 100 : null;
---
<Base titulo={`${c.nombre} · ¿En qué quedó?`} descripcion={`Seguimiento del caso: ${pesos(c.cuestionado)} cuestionados, ${pesos(c.recuperado)} recuperados.`} actual="casos">
  <article class="pieza">
    <header class="cabecera">
      <p class="kicker"><a href={url("en-que-quedo/")} style="text-decoration:none">¿En qué quedó?</a> · seguimiento de la plata pública</p>
      <h1>{c.nombre}</h1>
      <p class="fecha"><span class={`estado estado-${c.estado.toLowerCase()}`}>{estadoTexto[c.estado] || c.estado}</span> · dossier abierto el {fechaLarga(c.abierto).toLowerCase()} · última actualización {fechaLarga(c.actualizado).toLowerCase()}</p>
    </header>
    <dl class="contador">
      <div><dt>Cuestionado</dt><dd>{pesos(c.cuestionado)}</dd><dd class="nota">{naturalezaTexto(c.naturaleza)}</dd></div>
      <div><dt>Recuperado</dt><dd class="patina">{pesos(c.recuperado)}</dd><dd class="nota">{pct == null ? "sin base comparable" : `${pct.toLocaleString("es-CL", { maximumFractionDigits: 1 })}% de lo cuestionado`}</dd></div>
      {c.retenido ? <div><dt>Retenido</dt><dd>{pesos(c.retenido)}</dd><dd class="nota">congelado, no cobrado</dd></div> : null}
    </dl>
    {c.notaCifra && <p class="metodo">Sobre la cifra: {c.notaCifra}</p>}
    {c.proximoHito && <p class="hito"><strong>Lo próximo.</strong> {c.proximoHito}</p>}
    <div class={c.secciones.length > 2 ? "con-indice" : undefined}>
    {c.secciones.length > 2 && <Indice entradas={c.secciones} titulo="En este caso" />}
    <div class="col-cuerpo">
    <div class="cuerpo" set:html={c.html} />
    <p class="aviso-legal">Las personas mencionadas gozan de presunción de inocencia. Su situación procesal es la que consta en las fuentes citadas, con fecha; nada se afirma como delito sin sentencia. Las respuestas y correcciones de los aludidos se publican con fecha.</p>
    <nav class="nav-dias"><span><a href={url("en-que-quedo/")}><span class="kicker gris">← Todos los casos</span>¿En qué quedó?</a></span><span></span></nav>
    </div>
    </div>
  </article>
</Base>
